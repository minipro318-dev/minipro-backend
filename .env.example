PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Option A: full URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minidb

# Option B (recommended if password has special chars): discrete fields
DB_USER=postgres
DB_PASSWORD=postgres 
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minidb

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

SESSION_SECRET=replace_with_another_long_random_secret

# Optional: required only for ADMIN self-registration.
ADMIN_REGISTRATION_KEY=replace_with_admin_invite_key

# Optional: guardian invite expiry (hours)
GUARDIAN_INVITE_EXPIRY_HOURS=72

# Guardian invite email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_EMAIL=Women Safety Platform <your_email@gmail.com>
FRONTEND_APP_URL=http://localhost:5173

# Nearby Help uses public OpenStreetMap/Overpass/OSRM services.
# No Google Maps API key is required.

# Safe Journey monitoring and escalation
JOURNEY_DEVIATION_THRESHOLD_METERS=120
JOURNEY_DEVIATION_REQUIRED_COUNT=3
JOURNEY_MAX_ACCURACY_FOR_DEVIATION_METERS=100
JOURNEY_CHECK_IN_TIMEOUT_SECONDS=120
JOURNEY_MONITOR_INTERVAL_MS=20000
JOURNEY_ESCALATION_EMAIL_RETRY_COUNT=2
JOURNEY_ESCALATION_EMAIL_RETRY_BACKOFF_MS=600

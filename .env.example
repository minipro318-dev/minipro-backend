PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Option A: full URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minidb

# Option B (recommended if password has special chars): discrete fields
DB_USER=postgres
DB_PASSWORD=postgres 
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minidb

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

SESSION_SECRET=replace_with_another_long_random_secret

# Optional: required only for ADMIN self-registration.
ADMIN_REGISTRATION_KEY=replace_with_admin_invite_key

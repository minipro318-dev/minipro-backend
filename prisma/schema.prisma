generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int            @id @default(autoincrement())
  name              String
  email             String         @unique
  mobile            String?        @unique
  passwordHash      String
  role              UserRole
  status            Boolean        @default(true)
  lastLogin         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  guardianLinks     GuardianLink[] @relation("EndUserLinks")
  monitoringLinks   GuardianLink[] @relation("GuardianLinks")
  reportedIncidents Incident[]     @relation("ReportedIncidents")
  resolvedIncidents Incident[]     @relation("ResolvedIncidents")
  locationLogs      IncidentLocation[]
  plannedJourneys   Journey[]      @relation("PlannedJourneys")
  guardianJourneyResponses GuardianJourneyResponse[] @relation("GuardianJourneyResponses")
  guardianInvitesSent GuardianInvite[] @relation("GuardianInvitesSent")
  guardianInvitesAccepted GuardianInvite[] @relation("GuardianInvitesAccepted")
  endUserJourneyResponses GuardianJourneyResponse[] @relation("EndUserJourneyResponses")
  aiSafetyEvents      AiSafetyEvent[]   @relation("AiSafetyEvents")
  escalatedAiSafetyEvents AiSafetyEvent[] @relation("AiSafetyEventEscalatedBy")

  @@index([role])
}

model GuardianLink {
  id         Int      @id @default(autoincrement())
  guardianId Int
  endUserId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  guardian   User     @relation("GuardianLinks", fields: [guardianId], references: [id], onDelete: Cascade)
  endUser    User     @relation("EndUserLinks", fields: [endUserId], references: [id], onDelete: Cascade)

  @@unique([guardianId, endUserId])
  @@index([guardianId])
  @@index([endUserId])
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}

model Incident {
  id            Int                @id @default(autoincrement())
  title         String             @default("Emergency SOS")
  description   String?
  status        IncidentStatus     @default(ACTIVE)
  reportedById  Int
  resolvedById  Int?
  resolvedByRole IncidentResolvedBy?
  resolvedAt    DateTime?
  resolutionNote String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reportedBy    User               @relation("ReportedIncidents", fields: [reportedById], references: [id], onDelete: Cascade)
  resolvedBy    User?              @relation("ResolvedIncidents", fields: [resolvedById], references: [id], onDelete: SetNull)
  locationLogs  IncidentLocation[]
  escalatedJourneys Journey[]
  guardianResponses GuardianJourneyResponse[]
  aiSafetyEvents AiSafetyEvent[]

  @@index([status])
  @@index([reportedById])
  @@index([createdAt])
}

model AiSafetyEvent {
  id                  Int                 @id @default(autoincrement())
  userId               Int
  eventType            String              @default("POSSIBLE_FALL")
  status               AiSafetyEventStatus @default(DETECTED)
  detectedAt           DateTime            @default(now())
  modelProvider        String
  modelVersion         String
  classifierType       String              @default("POSE_HEURISTIC")
  classifierScore      Float?
  classifierConfidence Float?
  confidenceLabel      String?
  lastKnownLatitude    Float?
  lastKnownLongitude   Float?
  lastKnownAccuracy    Float?
  lastKnownAddress     String?
  confirmationDeadline DateTime?
  userResponse         String?
  responseReason       String?
  respondedAt          DateTime?
  notificationError    String?
  notifiedAt           DateTime?
  linkedIncidentId     Int?
  escalationReason     String?
  escalatedAt          DateTime?
  escalatedById        Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation("AiSafetyEvents", fields: [userId], references: [id], onDelete: Cascade)
  linkedIncident       Incident?           @relation(fields: [linkedIncidentId], references: [id], onDelete: SetNull)
  escalatedBy          User?               @relation("AiSafetyEventEscalatedBy", fields: [escalatedById], references: [id], onDelete: SetNull)

  @@index([userId, status, detectedAt])
  @@index([status, confirmationDeadline])
  @@index([linkedIncidentId])
  @@index([detectedAt])
}

model IncidentLocation {
  id          Int      @id @default(autoincrement())
  incidentId  Int
  latitude    Float
  longitude   Float
  accuracy    Float?
  locationTimestamp DateTime @default(now())
  address     String?
  source      String   @default("USER_UPDATE")
  createdById Int
  createdAt   DateTime @default(now())
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@index([createdById])
}

model Journey {
  id                   Int                    @id @default(autoincrement())
  title                String                 @default("Safe Journey")
  destinationName      String
  destinationLatitude  Float
  destinationLongitude Float
  status               JourneyStatus          @default(PLANNED)
  plannedById          Int
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  endedAt              DateTime?
  expectedArrivalAt    DateTime?
  routePolyline        String?
  routeDistanceMeters  Int?
  routeDurationSeconds Int?
  currentLatitude      Float?
  currentLongitude     Float?
  currentAccuracy      Float?
  currentAddress       String?
  currentLocationAt    DateTime?
  offRouteCount        Int                    @default(0)
  checkInReason        String?
  checkInRequiredAt    DateTime?
  checkInExpiresAt     DateTime?
  checkInAcknowledgedAt DateTime?
  escalatedAt          DateTime?
  escalationIncidentId Int?
  lastEscalationNotifiedAt DateTime?
  lastEscalationNotificationError String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  plannedBy            User                   @relation("PlannedJourneys", fields: [plannedById], references: [id], onDelete: Cascade)
  escalationIncident   Incident?              @relation(fields: [escalationIncidentId], references: [id], onDelete: SetNull)
  locations            JourneyLocation[]
  events               JourneyEvent[]
  guardianResponses    GuardianJourneyResponse[]

  @@index([plannedById, status])
  @@index([status, checkInExpiresAt])
  @@index([escalationIncidentId])
  @@index([createdAt])
}

model GuardianJourneyResponse {
  id               Int      @id @default(autoincrement())
  journeyId        Int
  incidentId       Int?
  guardianId       Int
  endUserId        Int
  message          String
  messageTemplateKey String?
  deliveredViaRealtime Boolean @default(false)
  deliveryError    String?
  createdAt        DateTime @default(now())
  journey          Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  incident         Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  guardian         User      @relation("GuardianJourneyResponses", fields: [guardianId], references: [id], onDelete: Cascade)
  endUser          User      @relation("EndUserJourneyResponses", fields: [endUserId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt])
  @@index([incidentId])
  @@index([guardianId])
  @@index([endUserId, createdAt])
}

model JourneyLocation {
  id                Int      @id @default(autoincrement())
  journeyId         Int
  latitude          Float
  longitude         Float
  accuracy          Float?
  address           String?
  locationTimestamp DateTime @default(now())
  source            String   @default("USER_UPDATE")
  createdAt         DateTime @default(now())
  journey           Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt])
}

model JourneyEvent {
  id         Int              @id @default(autoincrement())
  journeyId  Int
  eventType  JourneyEventType
  message    String
  actorRole  UserRole?
  actorId    Int?
  metadata   Json?
  createdAt  DateTime         @default(now())
  journey    Journey          @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt])
  @@index([eventType])
}

model GuardianInvite {
  id                 Int                 @id @default(autoincrement())
  invitedById        Int
  acceptedGuardianId Int?
  guardianName       String
  guardianEmail      String
  guardianMobile     String
  inviteCode         String              @unique
  status             GuardianInviteStatus @default(PENDING)
  expiresAt          DateTime
  acceptedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invitedBy          User                @relation("GuardianInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedGuardian   User?               @relation("GuardianInvitesAccepted", fields: [acceptedGuardianId], references: [id], onDelete: SetNull)

  @@index([invitedById, status])
  @@index([guardianEmail])
  @@index([guardianMobile])
}

enum UserRole {
  ADMIN
  GUARDIAN
  END_USER
}

enum IncidentStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

enum IncidentResolvedBy {
  USER
  GUARDIAN
  ADMIN
}

enum GuardianInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum JourneyStatus {
  PLANNED
  ACTIVE
  CHECK_IN_REQUIRED
  COMPLETED
  CANCELLED
  ESCALATED
}

enum JourneyEventType {
  JOURNEY_CREATED
  JOURNEY_STARTED
  LOCATION_RECORDED
  DEVIATION_DETECTED
  CHECK_IN_REQUIRED
  SAFETY_CONFIRMED
  GUARDIAN_RESPONSE_SENT
  JOURNEY_COMPLETED
  JOURNEY_CANCELLED
  ESCALATED_TO_SOS
}

enum AiSafetyEventStatus {
  DETECTED
  AWAITING_CONFIRMATION
  ACKNOWLEDGED
  FALSE_ALARM
  ESCALATED
  EXPIRED
  CANCELLED
}
